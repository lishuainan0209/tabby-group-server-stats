{
    "name": "tabby-group-server-stats",
    "version": "1.8.3",
    "description": "Tabby server monitoring: CPU, memory, disk, network and GPU metrics with grouped labels and hover details. Tabby 服务器监控：显存、磁盘、网络、自定义指标与多标签组。",
    "keywords": [
        "tabby-plugin",
        "tabby",
        "server-stats",
        "server-monitoring",
        "ssh",
        "metrics",
        "stats",
        "monitoring",
        "gpu",
        "disk",
        "memory",
        "network",
        "metric-groups",
        "服务器监控",
        "显存",
        "标签组"
    ],
    "author": {
        "name": "lishuainan0209",
        "url": "https://github.com/lishuainan0209"
    },
    "contributors": [
        {
            "name": "Akkariin",
            "url": "https://github.com/kasuganosoras"
        }
    ],
    "license": "MIT",
    "homepage": "https://github.com/lishuainan0209/tabby-group-server-stats#readme",
    "bugs": {
        "url": "https://github.com/lishuainan0209/tabby-group-server-stats/issues"
    },
    "main": "dist/index.js",
    "typings": "typings/index.d.ts",
    "scripts": {
        "build": "webpack --progress --color && tsc -p tsconfig.typings.json",
        "watch": "webpack --watch --progress --color",
        "typecheck": "tsc --noEmit",
        "test": "node --test tests/backend.test.cjs tests/display.test.cjs tests/settings.test.cjs tests/lifecycle.test.cjs tests/scope.test.cjs tests/scope-runtime.test.cjs tests/presets.test.cjs tests/transport.test.cjs tests/preset-github.test.cjs tests/builtin-order.test.cjs tests/login-users.test.cjs tests/network.test.cjs tests/tutorial.test.cjs tests/disk-io.test.cjs",
        "test:ui": "node tests/browser.test.cjs",
        "prepack": "npm run typecheck && npm test && npm run build"
    },
    "files": [
        "dist",
        "typings",
        "README.md",
        "LICENSE",
        "NOTICE",
        "PUBLISHING.zh-CN.md",
        "README.en.md",
        "presets.json",
        "docs/images",
        "docs/tutorial.zh-CN.pdf",
        "docs/tutorial.en.pdf"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/lishuainan0209/tabby-group-server-stats.git"
    },
    "dependencies": {
        "chart.js": "^4.4.0",
        "ng2-charts": "^4.1.0"
    },
    "peerDependencies": {
        "@angular/animations": "^14.0.0 || ^15.0.0",
        "@angular/common": "^14.0.0 || ^15.0.0",
        "@angular/core": "^14.0.0 || ^15.0.0",
        "@angular/forms": "^14.0.0 || ^15.0.0",
        "@angular/platform-browser": "^14.0.0 || ^15.0.0",
        "rxjs": "^7.5.0",
        "tabby-core": "*",
        "tabby-settings": "*",
        "tabby-terminal": "*"
    },
    "devDependencies": {
        "@angular/animations": "^14.0.0",
        "@angular/cdk": "^14.0.0",
        "@angular/common": "^14.0.0",
        "@angular/compiler": "^14.0.0",
        "@angular/compiler-cli": "^14.0.0",
        "@angular/core": "^14.0.0",
        "@angular/forms": "^14.0.0",
        "@angular/platform-browser": "^14.0.0",
        "@angular/platform-browser-dynamic": "^14.0.0",
        "@ng-bootstrap/ng-bootstrap": "^14.0.0",
        "@popperjs/core": "^2.11.6",
        "@types/node": "^16.0.0",
        "css-loader": "^6.7.0",
        "playwright-core": "1.58.2",
        "reflect-metadata": "0.2.2",
        "rxjs": "^7.5.0",
        "sass": "^1.56.0",
        "sass-loader": "^13.2.0",
        "tabby-core": "latest",
        "tabby-settings": "latest",
        "tabby-terminal": "latest",
        "to-string-loader": "^1.2.0",
        "ts-loader": "^9.0.0",
        "typescript": "^4.7.0",
        "webpack": "^5.0.0",
        "webpack-cli": "^4.0.0",
        "zone.js": "0.11.8"
    }
}
